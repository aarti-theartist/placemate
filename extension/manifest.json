{
  "manifest_version": 3,
  "name": "FocusFlow – Study Timer, To-Do & Job Match",
  "version": "1.1.0",
  "description": "Pomodoro study timer, task list, and resume-based job suggestions with apply links.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://remotive.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
